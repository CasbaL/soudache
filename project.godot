[layer_names]

2d_physics/layer_1="player"
2d_physics/layer_2="enemies"
2d_physics/layer_3="resources"
2d_physics/layer_4="walls"
2d_physics/layer_5="projectiles"
2d_physics/layer_6="enemy_bullets"

[physics]

2d/default_gravity=0

[rendering]

