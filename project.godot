; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="仙侠搜打撤"
config/description="移动端仙侠题材生存建造游戏"
config/tags=PackedStringArray("2d", "action", "rpg")
run/main_scene="res://scenes/ui/faction_select.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
FactionSystem="*res://scripts/systems/faction_system.gd"
SkillSystem="*res://scripts/systems/skill_system.gd"
EquipmentSystem="*res://scripts/systems/equipment_system.gd"
EnhanceSystem="*res://scripts/systems/enhance_system.gd"
EnemySpawner="*res://scripts/systems/enemy_spawner.gd"
BuildingSystem="*res://scripts/systems/building_system.gd"
AlchemySystem="*res://scripts/systems/alchemy_system.gd"
CraftingSystem="*res://scripts/systems/crafting_system.gd"
RealmSystem="*res://scripts/systems/realm_system.gd"
TechniqueSystem="*res://scripts/systems/technique_system.gd"
ShopSystem="*res://scripts/systems/shop_system.gd"
PortalSystem="*res://scripts/systems/portal_system.gd"
FarmSystem="*res://scripts/systems/farm_system.gd"
TreasureVaultSystem="*res://scripts/systems/treasure_vault_system.gd"
NPCInteractionSystem="*res://scripts/systems/npc_interaction_system.gd"
CombatFeedback="*res://scripts/systems/combat_feedback.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

